# Copy to .env.local and fill in. Never commit .env.local.
# The server validates these at startup (src/server/env.ts) and exits with a
# list of problems if any are missing or malformed.

# PostgreSQL connection URL. The user, password and database below match the
# local-only defaults in docker-compose.yml; replace them for any other server.
# Production (docs/DEPLOY.md): Neon's direct connection string with
# sslmode=verify-full, set in the host's dashboard, never in a file.
DATABASE_URL=postgres://soleup:soleup@localhost:5432/soleup_dev

# Database for `pnpm test:integration`. Must be local and its name must end in
# `_test`: the tests delete all data in it. Not read by the app itself.
TEST_DATABASE_URL=postgres://soleup:soleup@localhost:5432/soleup_test

# Better Auth (required). Secret: at least 32 random characters, e.g.
# `openssl rand -base64 32`. Changing it signs everyone out.
BETTER_AUTH_SECRET=
# Public base URL of the app, e.g. http://localhost:3000 in development.
BETTER_AUTH_URL=http://localhost:3000

# OAuth apps (see README > Authentication). Create your own; never share them.
# A provider is enabled only when both its ID and secret are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
