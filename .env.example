# Configuration template: copy to .env.local, then fill in your real values.
# This template is committed to Git; keep secrets in .env.local instead.
# For deployment, copy the filled values into your host's environment settings.
# The app validates its required configuration at startup (src/server/env.ts).

# PostgreSQL (required): Neon connection string with Connection pooling ON.
# Replace sslmode=require with sslmode=verify-full; keep other parameters.
DATABASE_URL=

# Migrations: Neon connection string with Connection pooling OFF.
# Also use sslmode=verify-full. Runtime uses pooled DATABASE_URL above.
DATABASE_URL_UNPOOLED=

# Required for file uploads/downloads. `neon deploy` fills these in .env.local.
# Copy all four existing values from .env.local when configuring your host.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Better Auth (required). Secret: at least 32 random characters, e.g.
# `openssl rand -base64 32`. Changing it signs everyone out.
BETTER_AUTH_SECRET=
# Required: your stable HTTPS app URL in production, without a trailing slash.
# Use http://localhost:3000 for local development.
BETTER_AUTH_URL=http://localhost:3000

# Configure at least one OAuth provider to let users sign in.
# Fill both values for each enabled provider; leave unused pairs blank.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Reminders (required). Bearer secret for POST /api/reminders/sweep, which
# cron-job.org calls in production and `pnpm reminders:sweep` calls locally.
# At least 32 random bytes, e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
# Use a different value in every environment. See docs/DEPLOY.md.
REMINDER_SWEEP_SECRET=

# Web Push (required). A VAPID key pair: generate it once per environment with
# `pnpm exec web-push generate-vapid-keys` and copy both lines. The public key
# is sent to browsers; the private key signs every push and must stay secret.
# Changing the pair stops delivery to every subscribed device until each one
# turns notifications on again. See docs/DEPLOY.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services if your pushes misbehave: mailto: or https://.
VAPID_SUBJECT=

# Optional hosting/build settings (no secrets).
COREPACK_ENABLE_DOWNLOAD_PROMPT=0
NEXT_TELEMETRY_DISABLED=1

# Local integration tests only. Do not add this to production hosting.
# Must be local and end in `_test`: integration tests delete its data.
TEST_DATABASE_URL=postgres://soleup:soleup@localhost:5432/soleup_test
