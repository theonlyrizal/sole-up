type IconName = (typeof allowlist)[number];

// These names remain public in the allowlist. The npm package publishes
// the canonical filenames (or, for expand/collapse, directional chevrons).
const alternateFiles: Partial<Record<IconName, string>> = {
  restore: "history",
  install_mobile: "mobile_arrow_down",
  expand_more: "keyboard_arrow_down",
  expand_less: "keyboard_arrow_up",
  cycle: "event_repeat",
};

const require = createRequire(import.meta.url);
const packagePath = require.resolve("@material-symbols/svg-400/package.json");
const rounded = join(dirname(packagePath), "rounded");
const files = new Set(readdirSync(rounded));

function editDistance(left: string, right: string): number {
  let previous = Array.from({ length: right.length + 1 }, (_, i) => i);
  for (let row = 1; row <= left.length; row++) {
    const current = [row];
    for (let column = 1; column <= right.length; column++) {
      current.push(
        Math.min(
          current[column - 1]! + 1,
          previous[column]! + 1,
          previous[column - 1]! + Number(left[row - 1] !== right[column - 1]),
        ),
      );
    }
    previous = current;
  }
  return previous[right.length]!;
}

function readPaths(name: IconName, suffix: "" | "-fill"): string[] {
  const expected = `${name}${suffix}.svg`;
  const alternate = alternateFiles[name];
  const filename = files.has(expected)
    ? expected
    : alternate && `${alternate}${suffix}.svg`;

  if (!filename || !files.has(filename)) {
    const closest = [...files]
      .filter(
        (file) =>
          file.endsWith(".svg") &&
          file.endsWith("-fill.svg") === Boolean(suffix),
      )
      .map((file) => ({ file, distance: editDistance(expected, file) }))
      .sort((a, b) => a.distance - b.distance || a.file.localeCompare(b.file))
      .slice(0, 5)
      .map(({ file }) => file);
    throw new Error(
      `Missing rounded/${expected} in @material-symbols/svg-400. Closest matches: ${closest.join(", ")}`,
    );
  }

  if (filename !== expected)
    console.log(`rounded/${expected} → rounded/${filename}`);
  const svg = readFileSync(join(rounded, filename), "utf8");
  const paths = Array.from(
    svg.matchAll(/<path\b[^>]*\bd="([^"]+)"/g),
    ([, d]) => d,
  );
  if (!svg.includes('viewBox="0 -960 960 960"') || !paths.length) {
    throw new Error(
      `Unexpected SVG viewBox or missing path data in rounded/${filename}`,
    );
  }
  return paths as string[];
}

const icons = Object.fromEntries(
  allowlist.map((name) => [
    name,
    { outline: readPaths(name, ""), filled: readPaths(name, "-fill") },
  ]),
);
const output = fileURLToPath(
  new URL("../src/components/icons/icon-paths.generated.ts", import.meta.url),
);
const source = `// Generated by pnpm icons:generate. Do not edit.
// Material Symbols Rounded via @material-symbols/svg-400 (see LICENSE).
export const ICON_PATHS = ${JSON.stringify(icons, null, 2)} as const;
`;
mkdirSync(dirname(output), { recursive: true });
writeFileSync(
  output,
  await format(source, { ...(await resolveConfig(output)), filepath: output }),
);
console.log(`Wrote ${allowlist.length} rounded icons with filled variants.`);
